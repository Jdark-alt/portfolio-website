---
import { getHome, getSite } from '../../lib/content';
import { inline } from '../../lib/text';
import { url } from '../../lib/url';

const { proof } = await getHome();
const { ui } = await getSite();
const numeric = (v: string) => (/^\d+$/.test(v) ? v : undefined);
---
<section class="proof" aria-label={ui.proofLabel}>
  <div class="wrap">
    <ul class="cells" role="list">
      {proof.map((m) => (
        <li class="cell" data-reveal>
          <p class="value num">
            <span data-count={numeric(m.value)}>{m.value}</span>{m.suffix && <span class="suffix">{m.suffix}</span>}
          </p>
          <p class="text" set:html={inline(m.label)} />
          <p class="src label">
            {m.href ? <a href={url(m.href)}>{m.tag}</a> : m.tag}
            <span class="sep" aria-hidden="true">·</span>
            <span>{ui.source}: {m.source}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }
  .cell { padding: 26px 24px 28px 0; min-width: 0; }
  .cell + .cell { padding-left: 24px; border-left: 1px solid var(--rule); }
  .value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(2.5rem, 1.6rem + 2.4vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .suffix { color: var(--fg-3); font-size: 0.55em; letter-spacing: 0; margin-left: 0.08em; }
  .text { margin-top: 12px; font-size: 0.9375rem; line-height: 1.45; color: var(--fg-2); max-width: 28ch; }
  .src { margin-top: 14px; color: var(--fg-quiet); text-transform: none; letter-spacing: 0.01em; line-height: 1.5; }
  .src a { color: var(--accent-ink); text-decoration: none; text-transform: uppercase; letter-spacing: var(--label-tracking); }
  .sep { margin-inline: 6px; }

  :global(html[data-direction='b']) .value { font-variation-settings: 'opsz' 60; font-weight: 400; }
  :global(html[data-direction='b']) .cells { border-top-color: var(--rule); }
  :global(html[data-direction='c']) .value { font-family: var(--font-label); font-weight: 500; font-stretch: 100%; letter-spacing: -0.04em; font-size: clamp(2.25rem, 1.5rem + 2vw, 3.25rem); }
  :global(html[data-direction='c']) .suffix { color: var(--accent); font-size: 1em; }
  :global(html[data-direction='c']) .cells { border-top-color: var(--rule); }

  @media (max-width: 899px) {
    .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell { padding: 22px 14px 24px 0; }
    .cell + .cell { padding-left: 14px; }
    .cell:nth-child(3) { padding-left: 0; border-left: 0; }
    .cell:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }
</style>
