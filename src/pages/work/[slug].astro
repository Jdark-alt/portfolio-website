---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Stub from '../../components/Stub.astro';
import { getProjects, getSite } from '../../lib/content';
import { getImage } from '../../lib/images';
import { inline } from '../../lib/text';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const site = await getSite();
const p = project.data;
const cover = await getImage(p.cover);
const isPhone = cover.src.height > cover.src.width;
---
<Base title={`${p.title}${p.expansion ? ` (${p.expansion})` : ''} · ${site.name}`} description={p.seoDescription} page="project">
  <Stub kicker={p.kicker} title={p.title} summary={p.oneLiner}>
    <div class="body">
      <figure class={isPhone ? 'phone' : 'plate'} style={`view-transition-name: cover-${project.id}`}>
        <Picture src={cover.src} alt={cover.alt} widths={isPhone ? [360, 560, 800] : [800, 1400, 2000]} sizes={isPhone ? '(min-width: 900px) 30vw, 70vw' : '100vw'} formats={['avif']} fallbackFormat="webp" />
      </figure>
      <div class="copy">
        <p class="role">{p.role}</p>
        <ul class="proofs" role="list">
          {p.proofs.map((m) => <li><b set:html={inline(m.value)} /> <span>{m.label}</span></li>)}
        </ul>
        <div class="note" set:html={project.rendered?.html ?? ''} />
      </div>
    </div>
  </Stub>
</Base>

<style>
  .body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); margin-top: 48px; align-items: start; }
  .phone { grid-column: 1 / span 4; border-radius: 34px; overflow: hidden; border: 7px solid #121214; box-shadow: var(--shadow); }
  .plate { grid-column: 1 / -1; border: 1px solid var(--rule); box-shadow: var(--shadow); }
  .copy { grid-column: 6 / span 7; }
  .plate + .copy { grid-column: 1 / span 8; margin-top: 40px; }
  .role { font-size: var(--step-1); line-height: 1.5; color: var(--fg-2); }
  .proofs { margin-top: 24px; border-top: 1px solid var(--rule); }
  .proofs li { padding: 12px 0; border-bottom: 1px solid var(--rule); display: flex; gap: 16px; align-items: baseline; }
  .proofs b { font-family: var(--font-display); font-weight: var(--display-weight); font-stretch: var(--display-stretch); font-size: 1.5rem; min-width: 5ch; }
  .note { margin-top: 24px; color: var(--fg-3); }
  @media (max-width: 899px) { .phone, .copy, .plate + .copy { grid-column: 1 / -1; } .phone { max-width: 320px; } .copy { margin-top: 32px; } }
</style>
