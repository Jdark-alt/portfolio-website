---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import HowIWork from '../components/home/HowIWork.astro';
import SectionHead from '../components/home/SectionHead.astro';
import ProjectEntrance from '../components/home/ProjectEntrance.astro';
import CaseStrip from '../components/home/CaseStrip.astro';
import Closing from '../components/home/Closing.astro';
import { getHome, getProjects, getSite } from '../lib/content';

const site = await getSite();
const home = await getHome();
const projects = await getProjects();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  description: site.description,
  email: `mailto:${site.contact.email}`,
  telephone: site.contact.phone,
  url: Astro.site?.href,
  sameAs: [site.contact.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Ahmedabad', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indira Gandhi National Open University (IGNOU)' },
  knowsAbout: ['Product management', 'AI product management', 'LLM features', 'PRDs', 'Product roadmaps', 'Product discovery', 'B2B SaaS', 'ERP'],
};
---
<Base title={home.seo.title} description={home.seo.description} jsonld={[person]} page="home">
  <Hero />
  <ProofStrip />
  <HowIWork />
  <section id={home.projects.id} class="work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead num="§2" id="work-title" title={home.projects.title} intro={home.projects.intro} />
      <div class="entrances">
        {projects.map((project, i) => <ProjectEntrance project={project} index={i} />)}
      </div>
    </div>
  </section>
  <CaseStrip />
  <Closing />
</Base>

<style>
  .work { padding-top: var(--section); }
  .entrances { margin-top: clamp(40px, 5vw, 72px); }
</style>
