---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewSwitcher from '../components/PreviewSwitcher.astro';
import { getSite } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Structured data objects to embed as JSON-LD. */
  jsonld?: object[];
  /** Extra class on <body>, e.g. the page type. */
  page?: string;
}
const { title, description, jsonld = [], page = '' } = Astro.props;
const site = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const defaultDirection = site.direction;
const preview = site.preview;
---
<!doctype html>
<html lang="en-IN" data-direction={defaultDirection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <!-- Applies the visual direction before first paint and marks JS as available. -->
    <script is:inline define:vars={{ defaultDirection, preview }}>
      (function () {
        var d = document.documentElement, dir = defaultDirection, store;
        try { store = window.localStorage; } catch (e) {}
        if (preview) {
          var q = new URLSearchParams(location.search).get('d');
          var saved = null;
          try { saved = store && store.getItem('jf-direction'); } catch (e) {}
          if (q && /^[abc]$/.test(q)) { dir = q; try { store && store.setItem('jf-direction', q); } catch (e) {} }
          else if (saved && /^[abc]$/.test(saved)) dir = saved;
        }
        d.setAttribute('data-direction', dir);
        d.classList.add('js');
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
        setTimeout(function () { if (!window.__jfMotion) d.classList.remove('js'); }, 3000);
      })();
    </script>
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {site.analyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}></script>
    )}
  </head>
  <body class={page}>
    <a class="skip" href="#main">{site.ui.skipLink}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {preview && <PreviewSwitcher />}
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: var(--gutter);
    top: calc(env(safe-area-inset-top, 0px) + 8px);
    z-index: 100;
    padding: 10px 14px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .skip:focus { transform: none; }
  main:focus { outline: none; }
</style>
